{
  "env": "production",
  "host": "0.0.0.0",
  "port": 443,
  "logLevel": "debug",
  "requestTimeoutMs": 2500,
  "maxBodyBytes": 2097152,
  "tls": { "enabled": true },
  "auth": { "secretEnv": "PROD_JWT_SECRET" },
  "rateLimit": { "rpm": 25000 },
  "database": { "poolMin": 4, "poolMax": 20 },
  "cors": { "origins": ["*"] }
}

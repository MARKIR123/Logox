{
  "name": "@kurios/logox",
  "version": "0.1.0",
  "type": "module",
  "description": "LOGOX terminal UI programming assistant and subagent ensemble",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MARKIR123/Logox.git"
  },
  "homepage": "https://github.com/MARKIR123/Logox#readme",
  "bugs": {
    "url": "https://github.com/MARKIR123/Logox/issues"
  },
  "keywords": [
    "tui",
    "agent",
    "terminal",
    "ai",
    "coding-assistant",
    "subagents",
    "multi-agent",
    "ink"
  ],
  "bin": {
    "logox": "./dist/src/cli.js",
    "logox-ts": "./dist/src/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src",
    "scripts/install-actor-profiles.mjs",
    "config.example.toml",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@playwright/mcp": "0.0.83",
    "@types/diff": "^7.0.2",
    "@vscode/ripgrep": "1.18.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "diff": "^9.0.0",
    "ink": "8.0.0",
    "react": "19.3.0",
    "smol-toml": "1.9.1",
    "string-width": "8.3.0",
    "undici": "8.10.2",
    "wrap-ansi": "10.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepack": "npm run build",
    "postinstall": "node scripts/install-actor-profiles.mjs",
    "browser:install": "playwright-mcp install-browser chromium",
    "check": "npm run check:docs && tsc --noEmit",
    "start": "node dist/src/cli.js",
    "test": "npm run check:docs && npm run build && node --test --test-concurrency=4 dist/tests/*.test.js",
    "build": "tsc && node scripts/copy-actor-profiles.mjs",
    "demo": "npm run build && node dist/src/cli.js --demo",
    "demo:actor-bar": "npm run build && node scripts/demo-actor-bar.mjs",
    "sync:profiles": "node scripts/sync-actor-profiles.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
